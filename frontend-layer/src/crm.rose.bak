.crm {
  --c-bg: #000;
  --c-panel: #0f0d0d;
  --c-lime: #edebdd;
  --c-blue: #810100;
  --c-grey: #630000;
  --c-dim: #b5aaa0;
  min-height: 100vh;
  background: var(--c-bg);
  color: #fff;
  font-family: "Inter", system-ui, sans-serif;
}
.crm-plain { padding: 20px clamp(16px, 4vw, 48px) 48px; }
.crm small { color: var(--c-dim); display: block; font-size: 12px; }
.crm .dim { color: var(--c-dim); }
.crm a { color: inherit; text-decoration: none; }

.crm-dot { width: 9px; height: 9px; border-radius: 50%; background: #2bd576; }
.crm-dot.off { background: #777; }

.crm-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
.crm-head h1 { font-family: inherit; color: #fff; font-size: clamp(34px, 6vw, 60px); font-weight: 500; letter-spacing: -0.02em; margin: 4px 0 0; }
.crm-head small { font-size: 14px; }
.crm-kpis { display: flex; gap: clamp(20px, 4vw, 48px); flex-wrap: wrap; }
.crm-kpis b { display: block; font-size: clamp(24px, 3.4vw, 40px); font-weight: 500; letter-spacing: -0.02em; }
.crm-notice { background: #3a1a12; color: #f4d77a; padding: 10px 14px; border-radius: 12px; font-size: 14px; }

.crm-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr); gap: 16px; margin-bottom: 16px; }
.crm-tiles { display: grid; gap: 16px; }
.tile { position: relative; border-radius: 22px; padding: 22px; min-height: 130px; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
.tile b { font-size: 44px; font-weight: 500; line-height: 1; }
.tile span { font-size: 14px; margin-top: 4px; }
.tile em { position: absolute; right: 22px; top: 22px; font-style: normal; font-size: 14px; }
.tile.hatch { background: repeating-linear-gradient(115deg, #7a6060 0 3px, #7a6060 3px 7px); }
.tile.lime { background: var(--c-lime); color: #1b1717; }

.crm-analytics { position: relative; background: var(--c-blue); border-radius: 22px; padding: 26px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
.crm-analytics small { color: #f0cdc6; }
.crm-analytics .big { font-size: clamp(56px, 8vw, 92px); font-weight: 500; line-height: 1; letter-spacing: -0.03em; }
.crm-analytics .chip { display: inline-block; background: rgba(255, 255, 255, .18); border-radius: 999px; padding: 4px 12px; font-size: 12px; margin: 8px 0 16px; }
.crm-analytics .chips { display: grid; gap: 8px; }
.crm-analytics .chips span { border: 1px solid rgba(255, 255, 255, .5); border-radius: 999px; padding: 8px 14px; font-size: 13px; width: fit-content; }
.donut-wrap { position: relative; width: clamp(150px, 20vw, 210px); aspect-ratio: 1; }
.donut { width: 100%; height: 100%; }
.ring-bg { fill: none; stroke: #000; stroke-width: 26; }
.ring-fg { fill: none; stroke: #fff; stroke-width: 26; transition: stroke-dasharray .8s ease; }
.donut-mid { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; font-size: 26px; font-weight: 500; }
.donut-mid small { color: #f0cdc6; font-size: 11px; }
.round-btn { position: absolute; right: 22px; bottom: 22px; width: 52px; height: 52px; border-radius: 50%; border: 0; background: #000; color: #fff; font-size: 20px; cursor: pointer; }

.crm-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
.panel { border-radius: 22px; padding: 22px; }
.panel.dark { background: var(--c-panel); }
.panel.white { background: #edebdd; color: #1b1717; }
.panel.white small { color: #6b6b73; }
.panel.grey { background: #4d3a3a; }
.panel-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 14px; font-size: 15px; }
.tag { background: var(--c-lime); color: #000; border-radius: 999px; padding: 2px 10px; font-size: 12px; }
.cash { font-size: 36px; font-weight: 500; margin-bottom: 8px; }
.bars { display: flex; align-items: flex-end; gap: 10px; height: 110px; margin-top: 10px; }
.bar-col { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 4px; }
.bar { width: 100%; border-radius: 10px 10px 0 0; }
.bar.b0 { background: #4d3a3a; }
.bar.b1 { background: #8a7570; }
.bar.b2 { background: #fff; }
.bar.b3 { background: var(--c-blue); }
.bar-labels { display: flex; gap: 10px; margin-top: 6px; }
.bar-labels small { flex: 1; text-align: center; font-size: 10px; }
.huge { font-size: 76px; font-weight: 500; line-height: 1.05; margin: 6px 0; }
.lime-btn { width: 44px; height: 44px; border-radius: 50%; background: var(--c-lime); color: #000 !important; display: grid; place-content: center; font-size: 18px; }
.dues { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
.dues li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.dues b { font-size: 22px; font-weight: 500; }
.dues span, .dues a { color: #e2dcd0; font-size: 14px; }
.dues a:hover, .name-link:hover { color: var(--c-lime); }
.name-link b { border-bottom: 1px dashed #7a6060; }

.back-link { display: inline-block; margin-bottom: 18px; color: var(--c-dim) !important; font-size: 14px; }
.back-link:hover { color: #fff !important; }
.crm-head .st { display: inline-block; margin-top: 10px; }
.profile-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 16px; align-items: start; }
.profile-side { display: grid; gap: 16px; }
.call-card { background: #2d2222; border-radius: 16px; padding: 14px 16px; margin-bottom: 10px; }
.call-card summary { display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; list-style: none; }
.call-card summary::-webkit-details-marker { display: none; }
.call-card summary b { font-weight: 500; }
.call-note { color: #e2dcd0; font-size: 13px; margin: 10px 0 0; }
.chat-log { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; max-height: 340px; overflow-y: auto; }
.crm .msg { max-width: 85%; padding: 9px 13px; border-radius: 16px; font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; background: #3a2c2c; }
.crm .msg small { margin-bottom: 2px; font-size: 11px; }
.crm .msg.agent { align-self: flex-start; border-top-left-radius: 5px; }
.crm .msg.borrower { align-self: flex-end; background: var(--c-blue); border-top-right-radius: 5px; }
.crm .msg.borrower small { color: #f0cdc6; }
.facts { display: grid; grid-template-columns: auto 1fr; gap: 10px 16px; margin: 0; font-size: 14px; }
.facts dt { color: #cfc5ba; }
.facts dd { margin: 0; text-align: right; }
.row-item { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid #3a2c2c; }
.row-item b { font-weight: 500; font-size: 17px; }
.row-right { display: grid; justify-items: end; gap: 4px; }
.crm .row-right a, .crm .wa-item a { color: var(--c-lime); text-decoration: underline; font-size: 13px; }
.wa-item { padding: 10px 0; border-top: 1px solid #3a2c2c; font-size: 14px; white-space: pre-wrap; overflow-wrap: anywhere; }
.crm .wa-status { color: var(--c-dim); font-size: 12px; }
.crm .wa-status.ok { color: var(--c-lime); }
.crm .wa-status.bad { color: #ff9aa4; }

.crm-table .scroll { overflow-x: auto; }
.crm table { width: 100%; border-collapse: collapse; min-width: 640px; }
.crm th { text-align: left; font-weight: 400; color: var(--c-dim); font-size: 12px; padding: 8px 10px; }
.crm td { padding: 12px 10px; border-top: 1px solid #3a2c2c; font-size: 14px; vertical-align: middle; }
.crm td b { font-weight: 500; }
.st { border-radius: 999px; padding: 4px 12px; font-size: 12px; background: #3a2c2c; }
.st.paid { background: var(--c-lime); color: #000; }
.st.due { background: #4d2a12; color: #f4d77a; }
.st.promised, .st.part_paid { background: #630000; color: #edebdd; }
.st.disputed, .st.do_not_call { background: #4d1a20; color: #ff9aa4; }
.lime-pill { background: var(--c-lime); color: #000; border: 0; border-radius: 999px; padding: 8px 16px; font-weight: 600; font-size: 13px; cursor: pointer; }
.latest { margin-top: 12px; }
.pill-row { display: flex; gap: 8px; flex-wrap: wrap; }
.ghost-pill { background: #3a2c2c; color: #fff; border: 0; border-radius: 999px; padding: 8px 16px; font-weight: 600; font-size: 13px; cursor: pointer; }
.ghost-pill:hover { background: #4d3a3a; }
.ghost-pill.danger { color: #ff9aa4; }
.head-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }

@media (max-width: 900px) {
  .crm-grid, .crm-row, .profile-grid { grid-template-columns: 1fr; }
  .crm-tiles { grid-template-columns: 1fr 1fr; }
}

/* status strip, toolbar, filters */

.lime-btn { border: 0; cursor: pointer; font: inherit; }
.toolbar { display: grid; gap: 10px; margin-bottom: 14px; }
.search { width: 100%; max-width: 420px; padding: 11px 16px; border-radius: 999px; border: 1.5px solid #3a2c2c; background: #1b1717; color: #fff; font: inherit; font-size: 14px; outline: none; box-sizing: border-box; }
.search::placeholder { color: #8a7570; }
.search:focus { border-color: var(--c-lime); }
.chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
.fchip { padding: 7px 14px; border-radius: 999px; border: 1px solid #4a3838; background: transparent; color: #e2dcd0; font: inherit; font-size: 13px; cursor: pointer; }
.fchip:hover { border-color: #7a6060; }
.fchip.on { background: var(--c-lime); border-color: var(--c-lime); color: #000; font-weight: 600; }
.fchip.clear { border-style: dashed; color: #ff9aa4; }
.th-sort { background: none; border: 0; padding: 0; color: inherit; font: inherit; cursor: pointer; }
.th-sort:hover { color: #fff; }
.text-btn { background: none; border: 0; padding: 0; color: var(--c-lime); font: inherit; font-size: 12px; cursor: pointer; text-decoration: underline; }
.owner { margin-top: 2px; }
.crm .mini-link { color: var(--c-lime); text-decoration: underline; }
.empty-rows { text-align: center; color: var(--c-dim); padding: 28px 0 8px; font-size: 14px; }
.small-pill { padding: 5px 12px; font-size: 12px; margin-top: 8px; }

/* messages + rules */
.crm-bottom { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 16px; margin-top: 16px; align-items: start; }

.wa-meta { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
.wa-meta b { font-weight: 500; }

@media (max-width: 900px) { .crm-bottom { grid-template-columns: 1fr; } }

/* call page */
.live-log { max-height: 55vh; min-height: 260px; }
.live-note { margin: 14px 0 0; font-size: 13px; }
.live-dot { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: #1b1717; animation: livePulse 1.4s infinite; }
@keyframes livePulse { 50% { opacity: .25; } }
.hang-btn { padding: 12px 26px; border: 0; border-radius: 999px; background: #c4333f; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
.hang-btn:hover { background: #d94452; }

/* tables (the old global table styles were removed) */
.crm th { text-transform: uppercase; letter-spacing: .06em; font-size: 11px; white-space: nowrap; }
.crm td { vertical-align: top; }
.crm tbody tr { transition: background .15s; }
.crm tbody tr:hover { background: #2e2323; }

/* dark scrollbars and form controls on the dark pages */
:root:has(.crm), :root:has(.gate-page) { color-scheme: dark; }
:root:has(.crm), :root:has(.crm) body { background: #000; }
.shell { min-height: 100vh; background: #000; }
.crm, .crm * { scrollbar-color: #5a4444 transparent; scrollbar-width: thin; }

/* page content fades in (the sidebar stays still) */
.main { animation: mainIn .4s cubic-bezier(.22, 1, .36, 1) both; }
@keyframes mainIn { from { opacity: 0; transform: translateY(8px); } }

.brand-mark { height: 38px; width: auto; color: #ac58e9; }

/* ---------- signed-in frame: sidebar + main ---------- */
.shell { display: grid; grid-template-columns: 248px minmax(0, 1fr); }
.side {
  position: sticky; top: 0; align-self: start; height: 100vh; height: 100dvh; overflow-y: auto; display: flex; flex-direction: column; gap: 26px; padding: 24px 14px 18px;
  background: #000; border-right: 1px solid #1f1a1a; box-sizing: border-box;
}
.side-brand { display: flex; align-items: center; gap: 10px; padding: 0 10px; font-size: 22px; font-weight: 600; letter-spacing: -.01em; }
.side-nav { display: flex; flex-direction: column; gap: 4px; }
.side-nav a { display: flex; align-items: center; gap: 13px; padding: 11px 14px; border-radius: 13px; color: #a9a9b1; font-size: 14.5px; transition: background .15s, color .15s; }
.side-nav a svg { width: 20px; height: 20px; flex: none; }
.side-nav a:hover { background: #141111; color: #fff; }
.side-nav a.on { background: #1a1515; color: #fff; font-weight: 600; box-shadow: inset 3px 0 0 var(--c-purple); }
.side-nav a.on svg { color: var(--c-purple); }
.side-foot { margin-top: auto; display: grid; gap: 10px; padding: 0 6px; }
.side-user { display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 14px; background: #0f0d0d; }
.side-user b { display: block; font-size: 14px; font-weight: 500; }
.side-logout { padding: 10px; border: 1px solid #26262b; border-radius: 12px; background: transparent; color: #cfcfd4; font: inherit; font-size: 13px; cursor: pointer; }
.side-logout:hover { background: #1b1b20; color: #fff; }
.main { min-width: 0; padding: 28px clamp(18px, 3vw, 44px) 56px; }
.crm { --c-purple: #ac58e9; }
.crm-dot { width: 9px; height: 9px; border-radius: 50%; background: #2bd576; flex: none; }
.crm-dot.off { background: #777; }
.side-brand .brand-mark { height: 34px; }
.main .crm-head h1 { font-size: clamp(30px, 4.4vw, 48px); }
.head-side { display: flex; }

/* stat cards, used at the top of the list pages */
.stat-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 16px; }
.stat-cards.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.stat-card { padding: 18px 20px; border-radius: 20px; background: var(--c-panel); border: 1px solid #3a2c2c; }
.stat-card b { display: block; margin-top: 6px; font-size: clamp(24px, 2.8vw, 34px); font-weight: 500; letter-spacing: -.02em; }
.stat-card.lime-card { background: var(--c-lime); border-color: var(--c-lime); color: #000; }
.stat-card.lime-card small { color: rgba(0, 0, 0, .6); }

/* dashboard extras */
.crm-bottom.even { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.see-all { color: var(--c-purple) !important; font-size: 13px; }
.see-all:hover { text-decoration: underline; }
.link-row { color: inherit; }
.link-row:hover { background: #2e2323; border-radius: 12px; }
.row-item.link-row { padding-left: 8px; padding-right: 8px; }

/* calls table: expanding transcript row */
.open-row td { background: #302424; }
.detail-row td { background: #211a1a; padding: 14px 18px 18px; }
.detail-row .chat-log { max-height: 320px; }

/* messages page */
.msg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
.wa-card { display: flex; flex-direction: column; gap: 8px; padding: 16px; border-radius: 18px; background: #2d2222; border: 1px solid #3a2c2c; }
.wa-card .wa-meta { display: flex; justify-content: space-between; gap: 10px; }
.wa-body { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; line-height: 1.5; }
.wa-card .small-pill { align-self: flex-start; margin-top: 2px; }
.crm .wa-card a { color: var(--c-lime); text-decoration: underline; }

/* settings page */
.settings-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
.rule-list { margin: 0; padding-left: 18px; color: #e2dcd0; font-size: 14px; line-height: 1.7; }
.action-gap { margin-top: 16px; }

@media (max-width: 1100px) {
  .stat-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .settings-grid, .crm-bottom.even { grid-template-columns: 1fr; }
}
@media (max-width: 860px) {
  .shell { grid-template-columns: 1fr; background: #000; }
  .side { position: static; height: auto; flex-direction: row; align-items: center; gap: 10px; padding: 10px 12px; overflow-x: auto; border-right: 0; border-bottom: 1px solid #1a1a1e; }
  .side-brand span { display: none; }
  .side-nav { flex-direction: row; gap: 2px; }
  .side-nav a { padding: 9px 12px; white-space: nowrap; }
  .side-nav a.on { box-shadow: none; }
  .side-foot { margin: 0 0 0 auto; display: flex; padding: 0; }
  .side-user div small { display: none; }
  .side-user { padding: 8px 10px; }
  .stat-cards.three { grid-template-columns: 1fr; }
}
